rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/workspaces/{workspaceId} {
      allow read: if owns(uid) && workspaceId == 'default';
      function validWorkspace() {
        return owns(uid) && workspaceId == 'default'
        && request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'metadataJson', 'updatedAt'])
        // 1: 0.7 storage, 2: summaries and bodies (specs/17). Both until the migration is complete.
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.revision is int
        && request.resource.data.metadataJson is string
        && request.resource.data.metadataJson.size() < 500000
        && request.resource.data.updatedAt == request.time;
      }
      allow create: if validWorkspace() && request.resource.data.revision == 1;
      allow update: if validWorkspace() && request.resource.data.revision == resource.data.revision + 1;
      match /notes/{noteId} {
        allow read: if owns(uid) && workspaceId == 'default';
        function legacyMemo() {
          // 0.7: the whole memo; the migration adds its summary next to it.
          return request.resource.data.keys().hasOnly(['schemaVersion', 'payloadJson', 'summaryJson', 'updatedAt'])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.payloadJson is string
            && request.resource.data.payloadJson.size() < 500000
            && (!('summaryJson' in request.resource.data) || (request.resource.data.summaryJson is string && request.resource.data.summaryJson.size() < 500000));
        }
        function summary() {
          return request.resource.data.keys().hasOnly(['schemaVersion', 'summaryJson', 'updatedAt'])
            && request.resource.data.schemaVersion == 2
            && request.resource.data.summaryJson is string
            && request.resource.data.summaryJson.size() < 500000;
        }
        allow create, update: if owns(uid) && workspaceId == 'default'
          && noteId.matches('^[A-Za-z0-9_-]{1,128}$')
          && (legacyMemo() || summary())
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(uid) && workspaceId == 'default';
      }
      match /bodies/{noteId} {
        allow read, delete: if owns(uid) && workspaceId == 'default';
        allow create, update: if owns(uid) && workspaceId == 'default'
          && noteId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly(['schemaVersion', 'documentJson', 'updatedAt'])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.documentJson is string
          && request.resource.data.documentJson.size() < 500000
          && request.resource.data.updatedAt == request.time;
      }
      // Which memos are shared, read only by their owner (specs/24_share_links.md). Each entry is made
      // together with its public copy, and is never changed: sharing again makes a new link.
      match /shareLinks/{noteId} {
        allow read, delete: if owns(uid) && workspaceId == 'default';
        allow create: if owns(uid) && workspaceId == 'default'
          && noteId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.matches('^[A-Za-z0-9_-]{22}$')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/shares/$(request.resource.data.token)).data.ownerUid == uid
          && getAfter(/databases/$(database)/documents/shares/$(request.resource.data.token)).data.noteId == noteId;
      }
      match /memoHistory/{noteId} {
        function historyOwner() {
          return owns(uid) && workspaceId == 'default' && noteId.matches('^[A-Za-z0-9_-]{1,128}$');
        }
        function memoExists() {
          return exists(/databases/$(database)/documents/users/$(uid)/workspaces/default/notes/$(noteId));
        }
        allow read, delete: if historyOwner();
        allow create, update: if historyOwner() && memoExists()
          && request.resource.data.keys().hasOnly(['schemaVersion', 'versionIds', 'contentHash', 'capturedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.versionIds is list
          && request.resource.data.versionIds.size() <= 20
          && request.resource.data.contentHash is string
          && request.resource.data.contentHash.matches('^[0-9a-f]{64}$')
          && request.resource.data.capturedAt == request.time;
        match /versions/{versionId} {
          allow read, delete: if historyOwner();
          allow create: if historyOwner() && memoExists() && versionId.matches('^[A-Za-z0-9_-]{1,128}$')
            && request.resource.data.keys().hasOnly(['schemaVersion', 'payloadJson', 'capturedAt'])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.payloadJson is string
            && request.resource.data.payloadJson.size() < 500000
            && request.resource.data.capturedAt == request.time;
        }
      }
    }
    // The Pro state: its owner reads it, only the server (Cloud Functions with the Admin SDK) writes it,
    // so nobody can make themselves Pro (specs/23_billing_foundation.md).
    match /users/{uid}/billing/{docId} {
      allow read: if owns(uid) && docId == 'subscription';
      allow write: if false;
    }
    // A shared memo's public copy (specs/24_share_links.md): anyone with the link reads it one at a time
    // while its owner is Pro and the operator has not blocked it; nobody can list them. Only a Pro owner
    // writes it, and the owner cannot clear `blocked`.
    match /shares/{token} {
      function ownerIsPro(owner) {
        return get(/databases/$(database)/documents/users/$(owner)/billing/subscription).data.plan == 'pro';
      }
      function validShare() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'noteId', 'title', 'documentJson', 'updatedAt', 'blocked'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.noteId is string
          && request.resource.data.noteId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 2000
          && request.resource.data.documentJson is string
          && request.resource.data.documentJson.size() < 500000
          && request.resource.data.blocked is bool
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if resource.data.blocked == false && ownerIsPro(resource.data.ownerUid);
      allow list: if false;
      allow create: if request.auth != null && token.matches('^[A-Za-z0-9_-]{22}$')
        && validShare() && request.resource.data.blocked == false && ownerIsPro(request.auth.uid);
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && validShare() && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.blocked == resource.data.blocked && ownerIsPro(request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // No client access to billing customers, processed Stripe events, other profiles, or unrecognized paths.
    match /{document=**} { allow read, write: if false; }
  }
}
